import { describe, it, expect, beforeEach, vi } from 'vitest';
import { renderHook, act } from '@testing-library/react';
import { useFileUpload } from './useFileUpload';

// Mock Supabase
vi.mock('../lib/supabase', () => ({
  supabase: {
    auth: {
      getUser: vi.fn(),
      getSession: vi.fn(),
    },
    storage: {
      from: vi.fn(),
    },
    from: vi.fn(),
  },
}));

import { supabase } from '../lib/supabase';

describe('useFileUpload', () => {
  const jobId = 'test-job-id';
  const userId = 'test-user-id';
  const mockFile = new File(['content'], 'test.pdf', { type: 'application/pdf' });

  beforeEach(() => {
    vi.clearAllMocks();
  });

  it('initializes with empty uploads array', () => {
    const { result } = renderHook(() => useFileUpload(jobId));
    expect(result.current.uploads).toEqual([]);
  });

  it('adds upload to state immediately when uploadFile is called', async () => {
    const mockSupabaseUser = { data: { user: { id: userId } } };
    vi.mocked(supabase.auth.getUser).mockResolvedValue(mockSupabaseUser as any);

    const mockStorageUpload = vi.fn().mockResolvedValue({ error: null });
    const mockStorageFrom = vi.fn().mockReturnValue({
      upload: mockStorageUpload,
    });
    vi.mocked(supabase.storage.from).mockReturnValue(mockStorageFrom() as any);

    const mockSupabaseInsert = vi.fn().mockReturnValue({
      insert: vi.fn().mockReturnValue({
        select: vi.fn().mockReturnValue({
          single: vi
            .fn()
            .mockResolvedValue({
              data: { id: 'candidate-id', job_id: jobId },
              error: null,
            }),
        }),
      }),
    });
    vi.mocked(supabase.from).mockReturnValue(mockSupabaseInsert() as any);

    const mockGetSession = vi
      .fn()
      .mockResolvedValue({ data: { session: { access_token: 'token' } } });
    vi.mocked(supabase.auth.getSession).mockReturnValue(mockGetSession() as any);

    global.fetch = vi.fn().mockResolvedValue({
      ok: true,
      json: async () => ({ processingStatus: 'Processing' }),
    });

    const { result } = renderHook(() => useFileUpload(jobId));

    await act(async () => {
      await result.current.uploadFile(mockFile);
    });

    // File should be added to uploads
    expect(result.current.uploads.length).toBeGreaterThan(0);
    expect(result.current.uploads[0].filename).toBe('test.pdf');
  });

  it('handles upload errors gracefully', async () => {
    const mockSupabaseUser = { data: { user: { id: userId } } };
    vi.mocked(supabase.auth.getUser).mockResolvedValue(mockSupabaseUser as any);

    const mockStorageUpload = vi
      .fn()
      .mockResolvedValue({ error: { message: 'Upload failed' } });
    const mockStorageFrom = vi.fn().mockReturnValue({
      upload: mockStorageUpload,
    });
    vi.mocked(supabase.storage.from).mockReturnValue(mockStorageFrom() as any);

    const { result } = renderHook(() => useFileUpload(jobId));

    await act(async () => {
      await result.current.uploadFile(mockFile);
    });

    // Upload should have failed status
    expect(result.current.uploads[0].status).toBe('Failed');
    expect(result.current.uploads[0].error).toBe('Upload failed');
  });

  it('gets current user ID and constructs correct storage path', async () => {
    const mockSupabaseUser = { data: { user: { id: userId } } };
    vi.mocked(supabase.auth.getUser).mockResolvedValue(mockSupabaseUser as any);

    const mockStorageUpload = vi.fn().mockResolvedValue({ error: null });
    const mockStorageFrom = vi.fn().mockReturnValue({
      upload: mockStorageUpload,
    });
    vi.mocked(supabase.storage.from).mockReturnValue(mockStorageFrom() as any);

    const mockSupabaseInsert = vi.fn().mockReturnValue({
      insert: vi.fn().mockReturnValue({
        select: vi.fn().mockReturnValue({
          single: vi
            .fn()
            .mockResolvedValue({
              data: { id: 'candidate-id', job_id: jobId },
              error: null,
            }),
        }),
      }),
    });
    vi.mocked(supabase.from).mockReturnValue(mockSupabaseInsert() as any);

    const mockGetSession = vi
      .fn()
      .mockResolvedValue({ data: { session: { access_token: 'token' } } });
    vi.mocked(supabase.auth.getSession).mockReturnValue(mockGetSession() as any);

    global.fetch = vi.fn().mockResolvedValue({
      ok: true,
      json: async () => ({ processingStatus: 'Processing' }),
    });

    const { result } = renderHook(() => useFileUpload(jobId));

    await act(async () => {
      await result.current.uploadFile(mockFile);
    });

    // Verify storage path construction
    const uploadCall = mockStorageUpload.mock.calls[0];
    const uploadPath = uploadCall[0];
    expect(uploadPath).toMatch(new RegExp(`^${userId}/${jobId}/`));
    expect(uploadPath).toContain('test.pdf');
  });

  it('inserts candidate row with correct data', async () => {
    const mockSupabaseUser = { data: { user: { id: userId } } };
    vi.mocked(supabase.auth.getUser).mockResolvedValue(mockSupabaseUser as any);

    const mockStorageUpload = vi.fn().mockResolvedValue({ error: null });
    const mockStorageFrom = vi.fn().mockReturnValue({
      upload: mockStorageUpload,
    });
    vi.mocked(supabase.storage.from).mockReturnValue(mockStorageFrom() as any);

    const mockInsertFn = vi.fn().mockReturnValue({
      select: vi.fn().mockReturnValue({
        single: vi
          .fn()
          .mockResolvedValue({
            data: { id: 'candidate-id', job_id: jobId },
            error: null,
          }),
      }),
    });

    const mockFromFn = vi.fn().mockReturnValue({
      insert: mockInsertFn,
    });

    vi.mocked(supabase.from).mockImplementation(mockFromFn as any);

    const mockGetSession = vi
      .fn()
      .mockResolvedValue({ data: { session: { access_token: 'token' } } });
    vi.mocked(supabase.auth.getSession).mockReturnValue(mockGetSession() as any);

    global.fetch = vi.fn().mockResolvedValue({
      ok: true,
      json: async () => ({ processingStatus: 'Processing' }),
    });

    const { result } = renderHook(() => useFileUpload(jobId));

    await act(async () => {
      await result.current.uploadFile(mockFile);
    });

    // Verify insert was called with correct table
    expect(mockFromFn).toHaveBeenCalledWith('candidates');
    expect(mockInsertFn).toHaveBeenCalledWith(
      expect.objectContaining({
        job_id: jobId,
        filename: 'test.pdf',
        processing_status: 'Uploaded',
      })
    );
  });

  it('calls POST /api/process-cv with candidateId and jobId', async () => {
    const candidateId = 'candidate-id';
    const mockSupabaseUser = { data: { user: { id: userId } } };
    vi.mocked(supabase.auth.getUser).mockResolvedValue(mockSupabaseUser as any);

    const mockStorageUpload = vi.fn().mockResolvedValue({ error: null });
    const mockStorageFrom = vi.fn().mockReturnValue({
      upload: mockStorageUpload,
    });
    vi.mocked(supabase.storage.from).mockReturnValue(mockStorageFrom() as any);

    const mockSupabaseInsert = vi.fn().mockReturnValue({
      insert: vi.fn().mockReturnValue({
        select: vi.fn().mockReturnValue({
          single: vi
            .fn()
            .mockResolvedValue({
              data: { id: candidateId, job_id: jobId },
              error: null,
            }),
        }),
      }),
    });
    vi.mocked(supabase.from).mockReturnValue(mockSupabaseInsert() as any);

    const mockGetSession = vi
      .fn()
      .mockResolvedValue({ data: { session: { access_token: 'token' } } });
    vi.mocked(supabase.auth.getSession).mockReturnValue(mockGetSession() as any);

    const mockFetch = vi.fn().mockResolvedValue({
      ok: true,
      json: async () => ({ processingStatus: 'Processing' }),
    });
    global.fetch = mockFetch;

    const { result } = renderHook(() => useFileUpload(jobId));

    await act(async () => {
      await result.current.uploadFile(mockFile);
    });

    // Verify fetch was called with correct endpoint and body
    expect(mockFetch).toHaveBeenCalledWith(
      '/api/process-cv',
      expect.objectContaining({
        method: 'POST',
        headers: expect.objectContaining({
          'Content-Type': 'application/json',
          Authorization: 'Bearer token',
        }),
        body: JSON.stringify({ candidateId, jobId }),
      })
    );
  });

  it('handles processing API errors', async () => {
    const mockSupabaseUser = { data: { user: { id: userId } } };
    vi.mocked(supabase.auth.getUser).mockResolvedValue(mockSupabaseUser as any);

    const mockStorageUpload = vi.fn().mockResolvedValue({ error: null });
    const mockStorageFrom = vi.fn().mockReturnValue({
      upload: mockStorageUpload,
    });
    vi.mocked(supabase.storage.from).mockReturnValue(mockStorageFrom() as any);

    const mockSupabaseInsert = vi.fn().mockReturnValue({
      insert: vi.fn().mockReturnValue({
        select: vi.fn().mockReturnValue({
          single: vi
            .fn()
            .mockResolvedValue({
              data: { id: 'candidate-id', job_id: jobId },
              error: null,
            }),
        }),
      }),
    });
    vi.mocked(supabase.from).mockReturnValue(mockSupabaseInsert() as any);

    const mockGetSession = vi
      .fn()
      .mockResolvedValue({ data: { session: { access_token: 'token' } } });
    vi.mocked(supabase.auth.getSession).mockReturnValue(mockGetSession() as any);

    global.fetch = vi.fn().mockResolvedValue({
      ok: false,
      json: async () => ({ error: 'Processing failed' }),
    });

    const { result } = renderHook(() => useFileUpload(jobId));

    await act(async () => {
      await result.current.uploadFile(mockFile);
    });

    // Upload should have failed status with error
    expect(result.current.uploads[0].status).toBe('Failed');
    expect(result.current.uploads[0].error).toBe('Processing failed');
  });

  it('tracks multiple file uploads independently', async () => {
    const mockSupabaseUser = { data: { user: { id: userId } } };
    vi.mocked(supabase.auth.getUser).mockResolvedValue(mockSupabaseUser as any);

    const mockStorageUpload = vi.fn().mockResolvedValue({ error: null });
    const mockStorageFrom = vi.fn().mockReturnValue({
      upload: mockStorageUpload,
    });
    vi.mocked(supabase.storage.from).mockReturnValue(mockStorageFrom() as any);

    const mockSupabaseInsert = vi.fn().mockReturnValue({
      insert: vi.fn().mockReturnValue({
        select: vi.fn().mockReturnValue({
          single: vi
            .fn()
            .mockResolvedValue({
              data: { id: 'candidate-id', job_id: jobId },
              error: null,
            }),
        }),
      }),
    });
    vi.mocked(supabase.from).mockReturnValue(mockSupabaseInsert() as any);

    const mockGetSession = vi
      .fn()
      .mockResolvedValue({ data: { session: { access_token: 'token' } } });
    vi.mocked(supabase.auth.getSession).mockReturnValue(mockGetSession() as any);

    global.fetch = vi.fn().mockResolvedValue({
      ok: true,
      json: async () => ({ processingStatus: 'Processing' }),
    });

    const { result } = renderHook(() => useFileUpload(jobId));

    const file1 = new File(['content1'], 'cv1.pdf');
    const file2 = new File(['content2'], 'cv2.docx');

    await act(async () => {
      await result.current.uploadFile(file1);
      await result.current.uploadFile(file2);
    });

    // Both files should be tracked
    expect(result.current.uploads).toHaveLength(2);
    expect(result.current.uploads[0].filename).toBe('cv1.pdf');
    expect(result.current.uploads[1].filename).toBe('cv2.docx');
  });
});
