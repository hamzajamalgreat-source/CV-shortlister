{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "api/**/*.ts",
    "src/engine/**/*.ts",
    "src/lib/grokClient.ts",
    "src/lib/schemas.ts",
    "src/types/**/*.ts"
  ]
}
